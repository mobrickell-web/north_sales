# Frontend app origin (used by siteConfig for canonical URLs)
SITE_URL=http://localhost:3000

# Optional production host canonicalization (Chunk 11).
# Example: CANONICAL_HOST=www.northpointsalesgroup.com
# permanently redirects the apex host to www (or the reverse).
# CANONICAL_HOST=

# North-Sales backend API base URL (NestJS on port 3001)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public Google OAuth web client ID used by Google Identity Services.
# Set the same ID in backend/GOOGLE_CLIENT_ID. Never expose GOOGLE_CLIENT_SECRET.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id